{
  "name": "@ladosite/grpc-sdk",
  "version": "0.0.6",
  "description": "Standalone gRPC SDK for OptiFlow outsource projects",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "Protos"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "node scripts/generate-proto.js",
    "build": "tsup",
    "prebuild": "npm run generate",
    "typecheck": "tsc --noEmit",
    "playground": "tsx playground/test-cli.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "grpc",
    "sdk",
    "optiflow"
  ],
  "author": "Ladosite",
  "license": "ISC",
  "dependencies": {
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@types/node": "^20.11.0",
    "protoc": "^24.4.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}